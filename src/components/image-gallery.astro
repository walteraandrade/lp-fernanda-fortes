---
import { Image } from "astro:assets";

interface Line {
  regular?: string;
  bold?: string;
}

interface Item {
  src: ImageMetadata;
  alt: string;
  lines: Line[];
  align: "left" | "right";
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<section class="flex justify-center flex-wrap gap-4">
  {
    items.map((item) => (
      <div class="flex flex-col items-center text-3xl pt-1 pb-3">
        <Image src={item.src} class="max-w-[250px]" alt={item.alt} loading="lazy" />
        <div class={`flex flex-col p-1 ${item.align === "left" ? "text-left" : "text-right"}`}>
          {item.lines.map((line) => (
            <p>
              {line.regular && <span class="text-amber-400">{line.regular} </span>}
              {line.bold && <span class="text-amber-950 font-semibold">{line.bold}</span>}
            </p>
          ))}
        </div>
      </div>
    ))
  }
</section>